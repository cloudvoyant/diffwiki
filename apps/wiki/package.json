{
  "name": "diffwiki-app",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "files": [
    "dist",
    "dist-static",
    "bin"
  ],
  "bin": {
    "diffwiki-app": "./bin/wiki-server.mjs"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:e2e": "vite dev --port 3100",
    "build": "vite build",
    "build:static": "vite build --outDir dist-static",
    "export": "node bin/export.mjs",
    "serve:static-e2e": "node tests/e2e/seed-fixture.mjs && node bin/export.mjs --out dist-site-e2e --base / && node bin/serve-static.mjs dist-site-e2e --port 5055",
    "preview": "vite preview",
    "start": "node bin/wiki-server.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src --no-error-on-unmatched-pattern && tsc --noEmit",
    "lint:fix": "eslint src --no-error-on-unmatched-pattern --fix",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.132.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "diffwiki-core": "workspace:*",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.0.0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "0.9.0"
}
