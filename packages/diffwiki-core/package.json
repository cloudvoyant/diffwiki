{
  "name": "diffwiki-core",
  "version": "0.14.0",
  "description": "Core configuration, registry, and article management for diffwiki",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./bm25": {
      "types": "./dist/bm25.d.ts",
      "import": "./dist/bm25.js",
      "require": "./dist/bm25.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src tests --no-error-on-unmatched-pattern && tsc --noEmit",
    "lint:fix": "eslint src tests --no-error-on-unmatched-pattern --fix"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.4",
    "@shikijs/rehype": "^3.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0"
  }
}
