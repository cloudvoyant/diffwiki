{
  "name": "diffwiki-monorepo",
  "version": "0.17.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "diffwiki — a git-based knowledge base CLI (monorepo root)",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"packages/*/{src,tests}/**/*.ts\" \"apps/*/{src,tests}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/{src,tests}/**/*.ts\" \"apps/*/{src,tests}/**/*.{ts,tsx}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^24.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "overrides": {
      "better-sqlite3": "12.10.0"
    }
  }
}
